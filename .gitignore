# Build Artifacts
# Note: In isolated agent workspaces (.workspaces/<agent>), `target` is a symlink to repo root target.
# Jujutsu processes gitignore rules differently for symlinks; agy_common::is_workspace_clean explicitly filters `target`.
target
target/
Cargo.lock.tmp
**/*.rs.bk
.cargo-ok

# C/C++ Artifacts
compile_commands.json
.cache/
*.o
*.a
*.so
*.dylib

# Profiling, Coverage & Mutation Testing
perf.data*
flamegraph.svg
*.profraw
*.profdata
lcov.info
coverage/
mutants.out/

# Environments & IDEs
.env
.env.*
!.env.example
.idea/
.zed/*
!.zed/debug.json
!.zed/tasks.json
*.swp
*~

# Multi-Agent Workspaces & Ephemeral State (.agy)
/.agy/

# Plugin Binary Bundles
plugins/agy-suite/bin/

# mdBook Build Output
docs/book/

