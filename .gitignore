# Build Artifacts
# Note: In isolated agent workspaces (.workspaces/<agent>), `target` is a symlink to repo root target.
# Jujutsu processes gitignore rules differently for symlinks; tkg_common::is_workspace_clean explicitly filters `target`.
target
target/
Cargo.lock.tmp
**/*.rs.bk
.cargo-ok

# C/C++ Artifacts
compile_commands.json
.cache/
*.o
*.a
*.so
*.dylib

# Profiling, Coverage & Mutation Testing
perf.data*
flamegraph.svg
*.profraw
*.profdata
lcov.info
coverage/
mutants.out/

# Environments & IDEs
.env
.env.*
!.env.example
.idea/
.zed/
*.swp
*~

# Multi-Agent Workspaces & Ephemeral State (.tkg)
/.tkg/

# Plugin Binary Bundles
plugins/torqkage/bin/*
!plugins/torqkage/bin/cargo-fast

# mdBook Build Output
docs/book/

