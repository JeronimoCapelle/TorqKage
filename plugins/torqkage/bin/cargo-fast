#!/usr/bin/env bash
# ==============================================================================
# cargo-fast — Turbo Compilation Runner for TorqKage
# ==============================================================================
# Automatically detects and leverages sccache, mold, and Cranelift if available,
# falling back gracefully to standard fast profile compilation.
# ==============================================================================
set -euo pipefail

# Strip sub-command if invoked as `cargo fast <action>`
if [[ "${1:-}" == "fast" ]]; then
    shift
fi

ACTION="build"
case "${1:-}" in
    build|b|run|r|check|c|test|t|clippy)
        ACTION="$1"
        shift
        ;;
esac

# 1. Compiler Cache Accelerator (sccache)
if command -v sccache &>/dev/null && [[ -z "${RUSTC_WRAPPER:-}" ]]; then
    export RUSTC_WRAPPER="sccache"
fi

# 2. Modern Linker Accelerator (mold)
EXT_RUSTFLAGS="${RUSTFLAGS:-}"
if command -v mold &>/dev/null && [[ "${EXT_RUSTFLAGS}" != *"-fuse-ld=mold"* ]]; then
    EXT_RUSTFLAGS="-C link-arg=-fuse-ld=mold ${EXT_RUSTFLAGS}"
fi
export RUSTFLAGS="${EXT_RUSTFLAGS}"

# 3. Nightly Cranelift Backend Overlay (if nightly is installed and config exists)
CARGO_CMD="cargo"
CONFIG_ARGS=()

if [[ -f ".cargo/config.fast.toml" ]] && command -v rustup &>/dev/null && rustup toolchain list 2>/dev/null | grep -q "^nightly"; then
    CARGO_CMD="cargo +nightly"
    CONFIG_ARGS=("--config" ".cargo/config.fast.toml")
fi

echo "==> [cargo-fast] Running '${ACTION} --profile fast' (RUSTC_WRAPPER: ${RUSTC_WRAPPER:-default}, Linker: $(command -v mold &>/dev/null && echo "mold" || echo "default"))..."
exec ${CARGO_CMD} "${ACTION}" --profile fast "${CONFIG_ARGS[@]}" "$@"
