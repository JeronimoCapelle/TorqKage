{
  "session-handoff-recorder": {
    "Stop": [
      {
        "type": "command",
        "command": "agy-hooks record-handoff",
        "timeout": 10
      }
    ]
  },
  "session-handoff-injector": {
    "SessionStart": [
      {
        "type": "command",
        "command": "agy-hooks inject-wake",
        "timeout": 5
      }
    ]
  },
  "wip-change-detector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "agy-hooks detect-wip",
        "timeout": 2
      }
    ]
  },
  "finisher-clippy-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_git_cliff",
        "hooks": [
          {
            "type": "command",
            "command": "agy-hooks check-clippy",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "deauthorized-agent-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agy-hooks deny-all",
            "timeout": 2
          }
        ]
      }
    ]
  }
}