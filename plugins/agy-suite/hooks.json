{
  "session-handoff-recorder": {
    "Stop": [
      {
        "type": "command",
        "command": "agy-hooks record-handoff",
        "timeout": 10
      }
    ]
  },
  "session-handoff-injector": {
    "SessionStart": [
      {
        "type": "command",
        "command": "agy-hooks inject-wake",
        "timeout": 5
      }
    ]
  },
  "wip-change-detector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "agy-hooks detect-wip",
        "timeout": 2
      }
    ]
  },
  "unified-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agy-hooks pre-tool-use",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
