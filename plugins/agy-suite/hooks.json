{
  "session-handoff-recorder": {
    "Stop": [
      {
        "type": "command",
        "command": "agy-hooks record-handoff",
        "timeout": 10
      }
    ]
  },
  "session-handoff-injector": {
    "SessionStart": [
      {
        "type": "command",
        "command": "agy-hooks inject-wake",
        "timeout": 5
      }
    ]
  },
  "wip-change-detector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "agy-hooks detect-wip",
        "timeout": 2
      }
    ]
  },
  "conflict-blocker": {
    "PreToolUse": [
      {
        "matcher": "run_cargo_.*|run_concurrency_tests|run_property_tests|run_mutation_tests|run_coverage_summary|run_quick_check",
        "hooks": [
          {
            "type": "command",
            "command": "agy-hooks check-conflicts",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "finisher-gatekeeper": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "agy-hooks check-finisher",
            "timeout": 30
          }
        ]
      }
    ]
  }
}